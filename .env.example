# Copy this file to .env for LOCAL DEVELOPMENT ONLY:  cp .env.example .env
# .env is git-ignored. Never commit real keys.
#
# On your phone you'll paste the key into Settings inside the app instead,
# so it never ends up in the code or the deployed site.

# YouTube Data API v3 key (optional, local dev only; see README → API keys).
# Production builds ignore it.
VITE_YOUTUBE_API_KEY=
